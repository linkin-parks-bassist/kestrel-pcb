	(text "GPIO7 enable defaults low. OE = NOT(enable AND rail release). MCU reset restarts supervisor delay."
		(at 20 255 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2e6ba4df-3775-5979-9eed-1dfbc189d332")
	)
	(text "63.4k/10k divider: nominal falling trip 2.9727V; CT open 12-28ms release. This is an isolation guard, not FPGA-valid proof."
		(at 20 262 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "b3d86bd3-8fd5-598e-98a4-dc006a83877b")
	)
	(text "Firmware must set CS high / CLK low before enabling, await FPGA configuration, and disable before controlled shutdown."
		(at 20 269 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
