	(text "KESTREL REV B - HARDWARE-CONFIGURED ADC/DAC - ENGINEERING DRAFT"
		(at 20 16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6c7d3a6f-52f3-5f73-a59e-a571da13a812")
	)
	(text "No audio I2C. Mono left channel. Protection and supervisor mute included; layout, rail hold-up and backend validation pending."
		(at 20 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b31d2de8-f219-5a4f-81a4-7a0f05458a6c")
	)
	(text "Clock target: synchronous 48 kHz LRCLK / 3.072 MHz BCLK / 12.288 MHz ADC MCLK. Current RTL must be migrated."
		(at 20 28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "02a6de17-e3c1-5266-a66d-400fc13ea31c")
	)
	(text "Input: approx 0.91 Mohm, bias 3.285 V at 9 V; 1:2 AC attenuation. Headroom/protection need tolerance review and bench tests."
		(at 20 264 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8ca5c12f-a8b0-54c4-92cc-2c37deb36f66")
	)
	(text "ADC VREF is decoupling only. VINR AC grounded. DAC charge-pump/bypass returns must be short; use one common ground plane."
		(at 20 270 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d3192011-9104-5833-92bb-e47d74f27673")
	)
	(text "DAC low-latency filter; supervisor AUDIO_RUN defaults muted. Protection/hold-up validation, sourcing and thermal checks remain."
		(at 20 276 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d9253070-b64b-5270-a58a-62a78674ac95")
	)
	(text "Source: TI PCM1808, PCM510xA, OPA1656, TLV767 and TLV755P datasheets. Do not fabricate this partial design."
