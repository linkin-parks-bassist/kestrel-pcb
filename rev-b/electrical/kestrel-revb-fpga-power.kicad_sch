	(text "FPGA FIXED CORE / SEQUENCED AUXILIARY AND I/O - ENGINEERING DRAFT"
		(at 20 18 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "6cadbc77-2cb5-5a86-a6a9-bc2f9d5ad100")
	)
	(text "TLV62569DBVR from 5 V; nominal core 1.0086 V. Never connect this rail to ESP32-P4 variable HP core."
		(at 20 26 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "33e34772-307c-581b-8c2b-afa223d0ba5a")
	)
	(text "Chosen core-first qualification; VCCX/IO share switched rail. UG206-1.9.3E: core first for >10 ms rail ramps."
		(at 20 117 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "d3e5a46c-1c5e-5f90-8536-b1283f41557f")
	)
	(text "FPGA_IO_EN uses equal 10k pullup/pulldown for ~1.65 V HIGH; assert only after core sense release and delay."
		(at 20 125 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "3e0735d5-01c1-5683-888c-f6c9387dbc77")
	)
	(text "TPS22965 CT 470 pF / 25 V gives about 0.65 ms typical 3.3 V rise at 5 V bias; not a guaranteed timing bound."
		(at 20 255 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "c021b39f-7c8c-581b-a6c6-d55bfe586262")
	)
	(text "FPGA VCCX, all banks, flash and oscillator use switched +3V3_FPGA; per-pin and PLL bypass are on the bare FPGA sheet."
		(at 20 263 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "7b3f0843-13a0-5e10-9d61-b3640272c49e")
	)
	(text "Verify load/ramp/dropout, low-power reset, shutdown and MCU/JTAG backfeed. Falling hysteresis has no guaranteed bound."
