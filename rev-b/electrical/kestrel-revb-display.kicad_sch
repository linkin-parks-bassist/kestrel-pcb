	(text "RGB565 / CAPACITIVE TOUCH - DM-TFT50-404 REFERENCE - ENGINEERING DRAFT"
		(at 20 15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "ada892a1-de18-545d-b426-c3add86d8fb3")
	)
	(text "RGB565: GPIO39/40/41/42/43 -> B3..7; GPIO44/45/46/47/32/49 -> G2..7; GPIO26/27/28/33/30 -> R3..7. Low panel data bits grounded."
		(at 20 375 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "28a1361e-ffd5-5a38-93fe-e4d6a9ac51a2")
	)
	(text "GPIO9 PCLK / 10 HSYNC / 11 VSYNC / 12 DE / 13 DISP. GPIO15 SCL / 16 SDA / 17 INT / 18 RESET."
		(at 20 382 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "4795bbd9-06f6-5706-95c0-ca991dd98d4a")
	)
	(text "LCD power 3.456V; GT911 VDD/VDDIO 3.2V. 4.7k I2C pullups to TOUCH_VDD. INT is bidirectional during reset/address selection."
		(at 20 389 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "507a8c49-6786-5b2d-962c-d6fd4ceef501")
	)
	(text "FPC contact side/numbering/thickness, exact parts, loaded signal timing, reset/address sequence and power-off/backfeed pending."
		(at 20 396 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "dca69eb4-7eae-5220-a39b-448b89152170")
	)
	(text "R1001..R1025 are source-damping starting values; place appropriately near drivers. No external hot-plug or EMC rating established."
		(at 20 403 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "e3df0e65-1dc8-5991-90db-9fa11ea32ec2")
