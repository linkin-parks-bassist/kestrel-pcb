	(text "ONBOARD BACKLIGHT BOOST - REFERENCE PANEL - ENGINEERING DRAFT"
		(at 20 15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "7d60e791-cd15-53bb-b589-c59f9bb84478")
	)
	(text "GPIO8 PWM defaults low. Use 5-100kHz; buffered on 5V domain with Ioff; controlled by firmware."
		(at 20 255 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "45c02502-30ca-5ed5-adc9-fce358c00133")
	)
	(text "5.62ohm sets 36.30mA nominal / <=39.55mA conditional TA>=25C limits. Cold-temperature regulation remains to qualify."
		(at 20 262 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "30fc94b5-1c56-54df-afbc-79d29bb83881")
	)
	(text "J1001: pin2 anode / pin1 cathode. Never ground LED cathode; Kelvin route to FB and R901."
		(at 20 269 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "599cd6d0-d731-52f1-80ba-5151dbd5e9bd")
	)
	(text "Disabled boost retains VIN-to-output passive path. Panel Vf must exceed VIN; no hard output disconnect or hot-plug claim."
		(at 20 276 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "7a0e1087-b510-5faa-a1df-3716d9a01abd")
	)
	(text "LCD and touch supplies onboard. Panel contact orientation, exact parts/effective capacitance and qualification pending."
		(at 20 248 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "4f936a4f-8479-544e-97b2-5fd81fd8c9a7")
	)
	(text "LCD LOGIC: TLV76701 / 33.2k:10k 0.1% / 3.456V nominal. Conditional DC corners 3.414..3.498V; not touch VDD."
		(at 20 310 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "c837c93a-7b4b-5821-9747-66a8317e45bd")
	)
	(text "Panel VDD 3.3..3.6V. 5V source headroom, load/thermal, effective capacitors, bus levels and ramp/backfeed require qualification."
		(at 20 317 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "47afb286-af29-5350-907e-88bd7f1f327f")
	)
	(text "TI adjustable DRV pins: 1 OUT, 2 FB, 3/5/EP GND, 4 EN, 6 IN. TP903 probes LCD power; J1001 is the LCD connector."
		(at 20 324 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "ea758489-1ac9-57e2-922d-314bcd63adcf")
	)
	(text "TOUCH: 30k:10k 0.1% / 3.2V nominal. GT911 recommended supply max3.3V, absolute max3.47V. Do not use LCD_VDD."
		(at 20 385 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "89c0e4ff-2a0f-5c22-9ac6-ad6a58a6cb53")
	)
	(text "Touch load, exact capacitors, reset/address timing, rail-ramp/backfeed and GPIO/I2C behavior require qualification."
		(at 20 392 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "1bf99bb1-e4f4-561d-ac7e-e280555995ec")
	)
